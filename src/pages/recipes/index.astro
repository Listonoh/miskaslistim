---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

type RecipeCard = {
  slug: string;
  title: string;
  description: string;
  tag: string;
  image: string | null;
};

const recipeModules = Object.entries(import.meta.glob('./*.md', { eager: true }));

const recipes: RecipeCard[] = recipeModules
  .map(([path, mod]) => {
    const slug = path.replace('./', '').replace(/\.md$/, '');
    const frontmatter = (mod as { frontmatter?: Record<string, unknown> }).frontmatter ?? {};
    const rawImage = typeof frontmatter.coverImage === 'string' ? frontmatter.coverImage : null;
    const image = rawImage ? `${base}${rawImage.replace(/^\/+/, '')}` : null;
    const tag =
      typeof frontmatter.tag === 'string'
        ? frontmatter.tag
        : typeof frontmatter.category === 'string'
          ? frontmatter.category
          : 'Recept';

    return {
      slug,
      title: typeof frontmatter.title === 'string' ? frontmatter.title : slug,
      description:
        typeof frontmatter.description === 'string'
          ? frontmatter.description
          : 'Poznámky k receptu a tipy k servírování.',
      tag,
      image,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout title="Recepty" description="Recepty z čajovny miska s listím.">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <p class="page-hero__eyebrow">aktuální</p>
      <h1>recepty</h1>
      <p class="page-hero__subtitle">Dobré věci k zakousnutí</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {recipes.length > 0 ? (
        <div class="content-cards-grid">
          {recipes.map((recipe) => (
            <a href={`${base}recipes/${recipe.slug}/`} class="content-card-link">
              <article class="card content-card">
                {recipe.image ? (
                  <img src={recipe.image} alt={recipe.title} class="card__img content-card__img" loading="lazy" />
                ) : (
                  <div class="content-card__img content-card__img--fallback" aria-hidden="true"></div>
                )}
                <div class="card__body">
                  <span class="card__tag">{recipe.tag}</span>
                  <h2 class="card__title content-card__title">{recipe.title}</h2>
                  <p class="card__text">{recipe.description}</p>
                </div>
              </article>
            </a>
          ))}
        </div>
      ) : (
        <article class="card empty-state-card">
          <div class="card__body">
            <span class="card__tag">Recepty</span>
              <h2 class="card__title">Zatím tu žádné recepty nejsou</h2>
            <p class="card__text">
                Přidejte markdown soubor do src/pages/recipes a automaticky se zobrazí zde i na vlastní stránce.
            </p>
          </div>
        </article>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
