---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "čajovna miska s listím" } = Astro.props;

// Build base URL respecting Astro's configured base
const base = import.meta.env.BASE_URL;
if (!Astro.site) {
  throw new Error('Astro "site" must be configured to generate structured data.');
}
const siteUrl = new URL(base, Astro.site).toString();
const isHomepage = Astro.url.pathname === new URL(base, Astro.site).pathname;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(isHomepage
      ? [{
          '@type': 'WebSite',
          '@id': `${siteUrl}#website`,
          url: siteUrl,
          name: 'čajovna miska s listím',
          inLanguage: 'cs-CZ',
          publisher: { '@id': `${siteUrl}#teahouse` },
        }]
      : []),
    {
      '@type': 'CafeOrCoffeeShop',
      '@id': `${siteUrl}#teahouse`,
      name: 'čajovna miska s listím',
      url: siteUrl,
      description: 'Čajovna v Praze 9 s výběrem čajů, bylinkových nápojů a domácího jídla.',
      image: new URL(`${base}zvenku.jpg`, Astro.site).toString(),
      telephone: '+420 730 256 031',
      email: 'info@miskaslistim.cz',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Poděbradská 242/10',
        addressLocality: 'Praha',
        postalCode: '190 00',
        addressCountry: 'CZ',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [
            'https://schema.org/Tuesday',
            'https://schema.org/Wednesday',
            'https://schema.org/Thursday',
            'https://schema.org/Friday',
            'https://schema.org/Saturday',
          ],
          opens: '14:00',
          closes: '22:00',
        },
      ],
    },
  ],
};
const showBanner = false; 
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P53532MWR6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-P53532MWR6');
    </script>
    <meta name="google-site-verification" content="ibyLCklfICNVy28hX0MKmIosCuAmJpexjoplJ1llTnc" />
  
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}favicon-msl.png`} />
    <title>{title} | čajovna miska s listím</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
  </head>
  

  <body>
    {showBanner ? (
      <div class="site-banner">
        UPOZORNĚNÍ: ČAJOVNA BUDE V SOBOTU 29. 8. ZAVŘENA.
      </div>
    ) : null}
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
